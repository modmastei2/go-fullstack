# Application Environment
APP_ENV=development
APP_FORCE_HTTPS=true
SYSTEM_NAME=backend
INIT_MAX_RETRY=5

# CORS Config
CORS_ALLOW_ORIGINS = http://localhost:3000

# Vault Config
VAULT_DEV_MODE=true
VAULT_HOST=http://host.docker.internal
VAULT_PORT=8200
VAULT_TOKEN=toor
VAULT_ROLE=

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MinIO Config
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=mybucket
MINIO_USE_SSL=false

# System Config
MULTIPLE_SESSION_USER=2

# Token & Session Configuration (in minutes for access, days for refresh/session)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_EXPIRE_DAYS=7
LOCK_SCREEN_TIMEOUT_SECONDS=600

# Docker Config
BACKEND_VERSION=lastest