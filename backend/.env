# Application Environment
APP_ENV=development
APP_FORCE_HTTPS=true
SYSTEM_NAME=backend
INIT_MAX_RETRY=5

# CORS Config
CORS_ALLOW_ORIGINS = http://localhost:3000

# Vault Config
VAULT_DEV_MODE=true
VAULT_HOST=http://host.docker.internal
VAULT_PORT=8200
VAULT_TOKEN=EXAMPLE_DEV_VAULT_ROOT_TOKEN
VAULT_ROLE=fiber-backend

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MinIO Config
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=mybucket
MINIO_USE_SSL=false

# System Config
ALLOW_MULTIPLE_SESSIONS=false

# Docker Config
BACKEND_VERSION=lastest

HTTP_CLIENT_TIMEOUT_MIN=3